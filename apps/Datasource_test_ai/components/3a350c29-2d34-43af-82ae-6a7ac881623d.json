  "id": "3a350c29-2d34-43af-82ae-6a7ac881623d",
  "name": "testingSummary",
  "type": "Html",
  "pageId": "b56ca727-7dfa-48b6-9ca3-0f09a0866072",
  "parent": null,
  "properties": {
    "rawHtml": {
      "value": "<div style=\"height:100%;box-sizing:border-box;margin:0;font-family:inherit;background:var(--cc-appBackground-surface)\"><div style=\"display:grid;grid-template-columns:repeat(5,1fr);gap:16px;height:100%\"><div style=\"padding:18px;background:var(--cc-surface1-surface);border:1px solid var(--cc-default-border);border-radius:12px\"><div style=\"font-size:12px;color:var(--cc-placeholder-text)\">Total tests</div><div style=\"font-size:28px;font-weight:700;line-height:42px;color:#0E7490\">{{(queries.getTestCases.data || []).length}}</div><div style=\"font-size:12px;color:var(--cc-placeholder-text)\">Generated metadata</div></div><div style=\"padding:18px;background:var(--cc-surface1-surface);border:1px solid var(--cc-default-border);border-radius:12px\"><div style=\"font-size:12px;color:var(--cc-placeholder-text)\">Passed</div><div style=\"font-size:28px;font-weight:700;line-height:42px;color:var(--cc-success-systemStatus)\">{{(queries.getTestCases.data || []).filter(r => r.status === 'Passed').length}}</div><div style=\"font-size:12px;color:var(--cc-placeholder-text)\">Latest status</div></div><div style=\"padding:18px;background:var(--cc-surface1-surface);border:1px solid var(--cc-default-border);border-radius:12px\"><div style=\"font-size:12px;color:var(--cc-placeholder-text)\">Failed</div><div style=\"font-size:28px;font-weight:700;line-height:42px;color:var(--cc-error-systemStatus)\">{{(queries.getTestCases.data || []).filter(r => r.status === 'Failed').length}}</div><div style=\"font-size:12px;color:var(--cc-placeholder-text)\">Needs investigation</div></div><div style=\"padding:18px;background:var(--cc-surface1-surface);border:1px solid var(--cc-default-border);border-radius:12px\"><div style=\"font-size:12px;color:var(--cc-placeholder-text)\">Blocked</div><div style=\"font-size:28px;font-weight:700;line-height:42px;color:#B45309\">{{(queries.getTestCases.data || []).filter(r => r.status === 'Blocked').length}}</div><div style=\"font-size:12px;color:var(--cc-placeholder-text)\">Configuration required</div></div><div style=\"padding:18px;background:var(--cc-surface1-surface);border:1px solid var(--cc-default-border);border-radius:12px\"><div style=\"font-size:12px;color:var(--cc-placeholder-text)\">Pass percentage</div><div style=\"font-size:28px;font-weight:700;line-height:42px\">{{(() => { const a=queries.getTestCases.data||[]; const p=a.filter(r=>r.status==='Passed').length; return a.length ? Math.round(p*1000/a.length)/10 + '%' : '0%'; })()}}</div><div style=\"font-size:12px;color:var(--cc-placeholder-text)\">All configured tests</div></div></div></div>"
    },
    "dynamicHeight": {
      "value": false
    },
    "visibility": {
      "value": true
    },
    "tooltipFormat": {
      "value": "plainText"
    }
