    "rawHtml": {
      "value": "<div style=\"height:100%;box-sizing:border-box;margin:0;font-family:inherit;background:var(--cc-appBackground-surface)\"><div style=\"display:grid;grid-template-columns:1.25fr 1fr 1fr 1fr;gap:16px;height:100%\"><div style=\"padding:18px;background:var(--cc-surface1-surface);border:1px solid var(--cc-default-border);border-radius:12px\"><div style=\"font-size:12px;color:var(--cc-placeholder-text)\">Discovered _ai datasources</div><div style=\"font-size:28px;font-weight:700;line-height:42px;color:#0E7490\">{{(queries.getPlugins.data || []).length}}</div><div style=\"font-size:12px;color:var(--cc-placeholder-text)\">Current QA metadata inventory</div></div><div style=\"padding:18px;background:var(--cc-surface1-surface);border:1px solid var(--cc-default-border);border-radius:12px\"><div style=\"font-size:12px;color:var(--cc-placeholder-text)\">Passing</div><div style=\"font-size:28px;font-weight:700;line-height:42px;color:var(--cc-success-systemStatus)\">{{(queries.getPlugins.data || []).filter(r => r.status === 'Passed').length}}</div><div style=\"font-size:12px;color:var(--cc-placeholder-text)\">Datasource status</div></div><div style=\"padding:18px;background:var(--cc-surface1-surface);border:1px solid var(--cc-default-border);border-radius:12px\"><div style=\"font-size:12px;color:var(--cc-placeholder-text)\">Failing</div><div style=\"font-size:28px;font-weight:700;line-height:42px;color:var(--cc-error-systemStatus)\">{{(queries.getPlugins.data || []).filter(r => r.status === 'Failed').length}}</div><div style=\"font-size:12px;color:var(--cc-placeholder-text)\">Needs QA attention</div></div><div style=\"padding:18px;background:var(--cc-surface1-surface);border:1px solid var(--cc-default-border);border-radius:12px\"><div style=\"font-size:12px;color:var(--cc-placeholder-text)\">Release ready</div><div style=\"font-size:28px;font-weight:700;line-height:42px\">{{(queries.getPlugins.data || []).filter(r => r.release_status === 'READY').length}}</div><div 